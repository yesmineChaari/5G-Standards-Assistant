# Environment
.venv/
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Data (large / regenerable)
data/raw/*
!data/raw/.gitkeep
data/indexes/*
!data/indexes/.gitkeep

# Evaluation caches. The recorded LLM calls and RAGAS judge scores are versioned so that
# `make eval` can be replayed without API keys; answers and retrieval results are recomputed.
eval/cache/*
!eval/cache/ragas.jsonl
!eval/cache/generation/
eval/cache/generation/*
!eval/cache/generation/llm_calls.jsonl

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
